# All optional. The app works fully with none of these set.

# Cloud sync (see supabase/schema.sql). Both must be set to enable it.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Override the pose model. Defaults to the copy vendored in public/models by
# `npm run assets:model`, falling back to Google's CDN if that is missing.
# Swap in pose_landmarker_full.task for more accuracy at a lower frame rate.
VITE_POSE_MODEL_URL=
