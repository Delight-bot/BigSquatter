{
  "name": "squat-challenge",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "prepare": "node scripts/copy-mediapipe.mjs",
    "assets:model": "node scripts/fetch-model.mjs",
    "assets:icons": "node scripts/generate-icons.mjs",
    "dev": "node scripts/copy-mediapipe.mjs && vite",
    "dev:lan": "node scripts/copy-mediapipe.mjs && cross-env VITE_HTTPS=1 vite --host",
    "build": "node scripts/copy-mediapipe.mjs && node scripts/fetch-model.mjs && tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint",
    "check": "tsc -b && oxlint && vitest run"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.0.1",
    "@supabase/supabase-js": "^2.117.2",
    "peerjs": "1.5.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.2",
    "cross-env": "^10.1.0",
    "jsdom": "^29.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.2"
  },
  "description": "A 30-day squat challenge that counts reps with on-device pose detection."
}
